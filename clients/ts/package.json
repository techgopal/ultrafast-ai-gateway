{
  "name": "@ultrafast/client",
  "version": "2.0.0-beta.3",
  "description": "TypeScript client for the Ultrafast gateway or a provider directly. Request building, parsing and stream decoding run in WebAssembly shared with the Rust client; networking uses the runtime's fetch.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/techgopal/ultrafast-ai-gateway#readme",
  "bugs": {
    "url": "https://github.com/techgopal/ultrafast-ai-gateway/issues"
  },
  "keywords": [
    "llm",
    "gateway",
    "openai",
    "anthropic",
    "typescript",
    "webassembly"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techgopal/ultrafast-ai-gateway.git",
    "directory": "clients/ts"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wasm/ultrafast_client_wasm_bg.wasm": "./dist/wasm/ultrafast_client_wasm_bg.wasm"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "lint": "eslint src tests --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "pnpm build:wasm && rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-wasm-glue.mjs",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.20.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
