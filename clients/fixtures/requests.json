{
  "description": "Each case: a target and a request, and the HTTP request every client must put on the wire. {base} is replaced by the address of a local server. Headers are those that must be present with exactly these values (names lower-case); auth_header names the header that must hold the key; x-uf-tags must be absent unless listed. Body is compared as JSON. sent=false: an error is raised and nothing is sent.",
  "key": "sk-fixture-key-0001",
  "cases": [
    {
      "name": "gateway chat with every option and tags",
      "op": "chat",
      "target": {
        "kind": "gateway",
        "base_url": "{base}"
      },
      "request": {
        "model": "gpt-4o",
        "messages": [
          {
            "role": "system",
            "content": "be brief"
          },
          {
            "role": "user",
            "content": "hi"
          }
        ],
        "max_tokens": 16,
        "temperature": 0.5,
        "top_p": 0.5,
        "stop": [
          "x"
        ],
        "tags": {
          "team": "search",
          "env": "prod"
        }
      },
      "expect": {
        "sent": true,
        "method": "POST",
        "path": "/v1/chat/completions",
        "auth_header": "authorization",
        "headers": {
          "content-type": "application/json",
          "x-uf-tags": "{\"env\":\"prod\",\"team\":\"search\"}"
        },
        "body": {
          "max_tokens": 16,
          "messages": [
            {
              "content": "be brief",
              "role": "system"
            },
            {
              "content": "hi",
              "role": "user"
            }
          ],
          "model": "gpt-4o",
          "stop": [
